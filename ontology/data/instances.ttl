@prefix ex: <http://example.org/onto-medical#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:DrBernard a ex:Doctor ;
    rdfs:label "Dr Bernard"@fr ;
    ex:name "Dr Bernard" ;
    ex:specialistIn ex:Asthme ;
    ex:treats ex:Bob ;
    ex:worksAt ex:HopitalPitieSalpetriere .

ex:DrDupont a ex:Doctor ;
    rdfs:label "Dr Dupont"@fr ;
    ex:name "Dr Dupont" ;
    ex:treats ex:Chloe ;
    ex:worksAt ex:HopitalSaintLouis .

ex:DrMartin a ex:Doctor ;
    rdfs:label "Dr Martin"@fr ;
    ex:name "Dr Martin" ;
    ex:specialistIn ex:Diabete ;
    ex:treats ex:Alice ;
    ex:worksAt ex:HopitalSaintLouis .

ex:Migraine a ex:Disease ;
    rdfs:label "Migraine"@fr ;
    ex:name "Migraine" .

ex:Alice a ex:Patient ;
    rdfs:label "Alice"@fr ;
    ex:hasDisease ex:Diabete ;
    ex:name "Alice" .

ex:Bob a ex:Patient ;
    rdfs:label "Bob"@fr ;
    ex:hasDisease ex:Asthme ;
    ex:name "Bob" .

ex:Chloe a ex:Patient ;
    rdfs:label "Chloé"@fr ;
    ex:hasDisease ex:Diabete ;
    ex:name "Chloé" .

ex:HopitalPitieSalpetriere a ex:Hospital ;
    rdfs:label "Hôpital Pitié-Salpêtrière"@fr ;
    ex:name "Hôpital Pitié-Salpêtrière" .

ex:Asthme a ex:Disease ;
    rdfs:label "Asthme"@fr ;
    ex:name "Asthme" .

ex:HopitalSaintLouis a ex:Hospital ;
    rdfs:label "Hôpital Saint-Louis"@fr ;
    ex:name "Hôpital Saint-Louis" .

ex:Diabete a ex:Disease ;
    rdfs:label "Diabète"@fr ;
    ex:name "Diabète" .

