@prefix chatbot: <http://example.org/chatbot#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nobel: <http://example.org/onto-nobel#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

chatbot:namePrefix a owl:AnnotationProperty .

<http://example.org/onto-nobel> a owl:Ontology ;
    dcterms:created "2026-09-28"^^xsd:date ;
    dcterms:source <https://www.wikidata.org> .

nobel:birthDate a owl:DatatypeProperty ;
    rdfs:label "date de naissance"@fr ;
    rdfs:comment "Personne -> date de naissance complète (xsd:date AAAA-MM-JJ), absente si seule l'année est connue. Pour une année, préférer nobel:birthYear."@fr ;
    rdfs:domain nobel:Person ;
    rdfs:range xsd:date .

nobel:birthYear a owl:DatatypeProperty ;
    rdfs:label "année de naissance"@fr ;
    rdfs:comment "Personne -> année de naissance (entier sans guillemets : nobel:birthYear 1913)."@fr ;
    rdfs:domain nobel:Person ;
    rdfs:range xsd:integer .

nobel:bornIn a owl:ObjectProperty ;
    rdfs:label "est né à"@fr ;
    rdfs:comment "Personne -> Lieu de naissance."@fr ;
    rdfs:domain nobel:Person ;
    rdfs:range nobel:Place .

nobel:category a owl:ObjectProperty ;
    rdfs:label "catégorie"@fr ;
    rdfs:comment "Attribution -> Prix Nobel (catégorie) attribué."@fr ;
    rdfs:domain nobel:NobelAward ;
    rdfs:range nobel:NobelPrize .

nobel:citizenOf a owl:ObjectProperty ;
    rdfs:label "a la nationalité"@fr ;
    rdfs:comment "Personne -> Pays dont elle a la nationalité (plusieurs possibles)."@fr ;
    rdfs:domain nobel:Person ;
    rdfs:range nobel:Country .

nobel:deathDate a owl:DatatypeProperty ;
    rdfs:label "date de décès"@fr ;
    rdfs:comment "Personne -> date de décès complète (xsd:date AAAA-MM-JJ), absente si seule l'année est connue. Pour une année, préférer nobel:deathYear."@fr ;
    rdfs:domain nobel:Person ;
    rdfs:range xsd:date .

nobel:deathYear a owl:DatatypeProperty ;
    rdfs:label "année de décès"@fr ;
    rdfs:comment "Personne -> année de décès (entier sans guillemets : nobel:deathYear 1960)."@fr ;
    rdfs:domain nobel:Person ;
    rdfs:range xsd:integer .

nobel:diedIn a owl:ObjectProperty ;
    rdfs:label "est mort à"@fr ;
    rdfs:comment "Personne -> Lieu de décès."@fr ;
    rdfs:domain nobel:Person ;
    rdfs:range nobel:Place .

nobel:doctoralAdvisor a owl:ObjectProperty ;
    rdfs:label "a pour directeur de thèse"@fr ;
    rdfs:comment "Personne (doctorant) -> Personne qui a dirigé sa thèse."@fr ;
    rdfs:domain nobel:Person ;
    rdfs:range nobel:Person .

nobel:educatedAt a owl:ObjectProperty ;
    rdfs:label "a étudié à"@fr ;
    rdfs:comment "Personne -> Établissement où elle a étudié."@fr ;
    rdfs:domain nobel:Person ;
    rdfs:range nobel:Institution .

nobel:familyName a owl:DatatypeProperty ;
    rdfs:label "nom de famille"@fr ;
    rdfs:comment "Personne -> nom de famille."@fr ;
    rdfs:domain nobel:Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf skos:altLabel .

nobel:gender a owl:DatatypeProperty ;
    rdfs:label "genre"@fr ;
    rdfs:comment "Personne -> genre : \"femme\" ou \"homme\"."@fr ;
    rdfs:domain nobel:Person ;
    rdfs:range xsd:string .

nobel:locatedIn a owl:ObjectProperty ;
    rdfs:label "se situe dans"@fr ;
    rdfs:comment "Lieu ou Établissement -> Pays où il se situe."@fr ;
    rdfs:range nobel:Country .

nobel:motivation a owl:DatatypeProperty ;
    rdfs:label "motivation"@fr ;
    rdfs:comment "Attribution -> motivation officielle du prix, en anglais."@fr ;
    rdfs:domain nobel:NobelAward ;
    rdfs:range xsd:string .

nobel:name a owl:DatatypeProperty ;
    rdfs:label "nom"@fr ;
    rdfs:comment "Tout individu -> nom lisible (chaîne sans langue). À utiliser pour désigner une entité par son nom : ?x nobel:name \"Marie Curie\"."@fr ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf rdfs:label .

nobel:received a owl:ObjectProperty ;
    rdfs:label "a reçu l'attribution"@fr ;
    rdfs:comment "Lauréat (Personne ou Organisation) -> Attribution qu'il a reçue."@fr ;
    rdfs:range nobel:NobelAward .

nobel:wonPrize a owl:ObjectProperty ;
    rdfs:label "a reçu"@fr ;
    rdfs:comment "Lauréat (Personne ou Organisation) -> Prix Nobel. Raccourci sans l'année ; pour l'année, passer par nobel:NobelAward."@fr ;
    rdfs:range nobel:NobelPrize .

nobel:worksFor a owl:ObjectProperty ;
    rdfs:label "a travaillé pour"@fr ;
    rdfs:comment "Personne -> Établissement qui l'a employée."@fr ;
    rdfs:domain nobel:Person ;
    rdfs:range nobel:Institution .

nobel:year a owl:DatatypeProperty ;
    rdfs:label "année"@fr ;
    rdfs:comment "Attribution -> année d'attribution du prix (entier sans guillemets : nobel:year 2024)."@fr ;
    rdfs:domain nobel:NobelAward ;
    rdfs:range xsd:integer .

