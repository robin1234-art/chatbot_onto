nobel:award_Q1002250_Q38104_2016 a nobel:NobelAward ;
    nobel:category wd:Q38104 ;
    nobel:motivation "for theoretical discoveries of topological phase transitions and topological phases of matter"@en ;
    nobel:year 2016 .

nobel:award_Q102034_Q80061_1902 a nobel:NobelAward ;
    nobel:category wd:Q80061 ;
    nobel:motivation "for his work on malaria, by which he has shown how it enters the organism and thereby has laid the foundation for successful research on this disease and methods of combating it."@en ;
    nobel:year 1902 .

nobel:award_Q102250_Q44585_2003 a nobel:NobelAward ;
    nobel:category wd:Q44585 ;
    nobel:motivation "for the discovery of water channels"@en ;
    nobel:year 2003 .

nobel:award_Q102266_Q44585_1989 a nobel:NobelAward ;
    nobel:category wd:Q44585 ;
    nobel:motivation "for their discovery of catalytic properties of RNA"@en ;
    nobel:year 1989 .

nobel:award_Q102278_Q44585_1972 a nobel:NobelAward ;
    nobel:category wd:Q44585 ;
    nobel:motivation "for his work on ribonuclease, especially concerning the connection between the amino acid sequence and the biologically active conformation"@en ;
    nobel:year 1972 .

nobel:award_Q102291_Q44585_1922 a nobel:NobelAward ;
    nobel:category wd:Q44585 ;
    nobel:motivation "for his discovery, by means of his mass spectrograph, of isotopes, in a large number of non-radioactive elements, and for his enunciation of the whole-number rule"@en ;
    nobel:year 1922 .

nobel:award_Q102379_Q44585_1980 a nobel:NobelAward ;
    nobel:category wd:Q44585 ;
    nobel:motivation "for his fundamental studies of the biochemistry of nucleic acids, with particular regard to recombinant-DNA"@en ;
    nobel:year 1980 .

nobel:award_Q102395_Q44585_1997 a nobel:NobelAward ;
    nobel:category wd:Q44585 ;
    nobel:motivation "for their elucidation of the enzymatic mechanism underlying the synthesis of adenosine triphosphate (ATP)"@en ;
    nobel:year 1997 .

nobel:award_Q102406_Q44585_1979 a nobel:NobelAward ;
    nobel:category wd:Q44585 ;
    nobel:motivation "for their development of the use of boron- and phosphorus-containing compounds, respectively, into important reagents in organic synthesis"@en ;
    nobel:year 1979 .

nobel:award_Q102419_Q44585_1969 a nobel:NobelAward ;
    nobel:category wd:Q44585 ;
    nobel:motivation "for their contributions to the development of the concept of conformation and its application in chemistry"@en ;
    nobel:year 1969 .

nobel:award_Q102454_Q47170_1970 a nobel:NobelAward ;
    nobel:category wd:Q47170 ;
    nobel:motivation "for the scientific work through which he has developed static and dynamic economic theory and actively contributed to raising the level of analysis in economic science"@en ;
    nobel:year 1970 .

