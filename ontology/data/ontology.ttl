@prefix chatbot: <http://example.org/chatbot#> .
@prefix ex: <http://example.org/onto-medical#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

chatbot:namePrefix a owl:AnnotationProperty .

ex:DrBernard a ex:Doctor ;
    rdfs:label "Dr Bernard"@fr ;
    ex:name "Dr Bernard" ;
    ex:specialistIn ex:Asthme ;
    ex:treats ex:Bob ;
    ex:worksAt ex:HopitalPitieSalpetriere .

ex:DrDupont a ex:Doctor ;
    rdfs:label "Dr Dupont"@fr ;
    ex:name "Dr Dupont" ;
    ex:treats ex:Chloe ;
    ex:worksAt ex:HopitalSaintLouis .

ex:DrMartin a ex:Doctor ;
    rdfs:label "Dr Martin"@fr ;
    ex:name "Dr Martin" ;
    ex:specialistIn ex:Diabete ;
    ex:treats ex:Alice ;
    ex:worksAt ex:HopitalSaintLouis .

ex:Migraine a ex:Disease ;
    rdfs:label "Migraine"@fr ;
    ex:name "Migraine" .

ex:hasDisease a owl:ObjectProperty ;
    rdfs:label "est atteint de"@fr ;
    rdfs:comment "Relie un patient à une maladie diagnostiquée."@fr ;
    rdfs:domain ex:Patient ;
    rdfs:range ex:Disease .

ex:name a owl:DatatypeProperty ;
    rdfs:label "nom"@fr ;
    rdfs:comment "Nom lisible d'un médecin, patient, maladie ou hôpital."@fr ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf rdfs:label .

ex:specialistIn a owl:ObjectProperty ;
    rdfs:label "est spécialiste de"@fr ;
    rdfs:comment "Relie un médecin à une maladie dont il est spécialiste."@fr ;
    rdfs:domain ex:Doctor ;
    rdfs:range ex:Disease .

ex:treats a owl:ObjectProperty ;
    rdfs:label "soigne"@fr ;
    rdfs:comment "Relie un médecin au patient qu'il soigne."@fr ;
    rdfs:domain ex:Doctor ;
    rdfs:range ex:Patient .

ex:worksAt a owl:ObjectProperty ;
    rdfs:label "travaille à"@fr ;
    rdfs:comment "Relie un médecin à l'hôpital où il exerce."@fr ;
    rdfs:domain ex:Doctor ;
    rdfs:range ex:Hospital .

ex:Alice a ex:Patient ;
    rdfs:label "Alice"@fr ;
    ex:hasDisease ex:Diabete ;
    ex:name "Alice" .

ex:Bob a ex:Patient ;
    rdfs:label "Bob"@fr ;
    ex:hasDisease ex:Asthme ;
    ex:name "Bob" .

ex:Chloe a ex:Patient ;
    rdfs:label "Chloé"@fr ;
    ex:hasDisease ex:Diabete ;
    ex:name "Chloé" .

ex:HopitalPitieSalpetriere a ex:Hospital ;
    rdfs:label "Hôpital Pitié-Salpêtrière"@fr ;
    ex:name "Hôpital Pitié-Salpêtrière" .

ex:Asthme a ex:Disease ;
    rdfs:label "Asthme"@fr ;
    ex:name "Asthme" .

ex:HopitalSaintLouis a ex:Hospital ;
    rdfs:label "Hôpital Saint-Louis"@fr ;
    ex:name "Hôpital Saint-Louis" .

ex:Diabete a ex:Disease ;
    rdfs:label "Diabète"@fr ;
    ex:name "Diabète" .

ex:Hospital a owl:Class ;
    rdfs:label "Hôpital"@fr ;
    chatbot:namePrefix "CHU"@fr,
        "Hôpital"@fr ;
    rdfs:comment "Un établissement de soins."@fr .

ex:Disease a owl:Class ;
    rdfs:label "Maladie"@fr ;
    rdfs:comment "Une pathologie pouvant être diagnostiquée chez un patient."@fr .

ex:Patient a owl:Class ;
    rdfs:label "Patient"@fr ;
    rdfs:comment "Une personne suivie médicalement."@fr .

ex:Doctor a owl:Class ;
    rdfs:label "Médecin"@fr ;
    chatbot:namePrefix "Docteur"@fr,
        "Docteure"@fr,
        "Dr"@fr ;
    rdfs:comment "Une personne qui exerce la médecine."@fr .

